* text=auto
*.cs text eol=lf
*.json text eol=lf
*.md text eol=lf
*.shader text eol=lf
*.unity text eol=lf
*.asset text eol=lf
*.prefab text eol=lf
*.meta text eol=lf

# Unified baseline patches need LF and their required blank context markers.
Tools/PerformanceAudit/Baselines/*.patch text eol=lf whitespace=-blank-at-eol

# Keep binary assets out of text merge attempts.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.psd binary
*.ase binary
*.aseprite binary
*.wav binary
*.mp3 binary
*.ogg binary
*.fbx binary
*.ttf binary
*.otf binary
