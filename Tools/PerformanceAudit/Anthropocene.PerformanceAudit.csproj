<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <LangVersion>9</LangVersion>
    <SimulationSource Condition="'$(SimulationSource)' == ''">../../Assets/_Anthropocene/Simulation</SimulationSource>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(SimulationSource)/*.cs" />
    <Compile Include="Program.cs" />
    <!-- Cost attribution needs the simulation's PhaseProfile; historical sources built for comparisons omit it. -->
    <Compile Include="Attribution.cs" Condition="Exists('$(SimulationSource)/PhaseProfile.cs')" />
  </ItemGroup>
  <PropertyGroup Condition="Exists('$(SimulationSource)/PhaseProfile.cs')">
    <DefineConstants>$(DefineConstants);ATTRIBUTION</DefineConstants>
  </PropertyGroup>
</Project>
