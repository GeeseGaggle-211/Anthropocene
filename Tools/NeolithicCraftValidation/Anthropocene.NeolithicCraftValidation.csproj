<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings><Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems><LangVersion>9</LangVersion>
    <SimulationSource Condition="'$(SimulationSource)' == ''">../../Assets/_Anthropocene/Simulation</SimulationSource>
    <EnableCraftDiagnostics Condition="'$(EnableCraftDiagnostics)' == ''">true</EnableCraftDiagnostics>
    <DefineConstants Condition="'$(EnableCraftDiagnostics)' == 'true'">$(DefineConstants);ISSUE33_DIAGNOSTICS</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(SimulationSource)/*.cs" />
    <Compile Include="Program.cs" />
    <Compile Include="PhysicalChainWitnesses.cs" />
    <Compile Include="CraftReplayChecks.cs" />
    <Compile Include="GeneratedSiteControls.cs" />
    <Compile Include="ScarcityControls.cs" />
  </ItemGroup>
</Project>
